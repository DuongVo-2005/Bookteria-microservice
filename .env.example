# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Public origin of the web app (nginx in bookteria-web). Used for socket URL,
# file download links and OAuth redirect URIs.
PUBLIC_BASE_URL=http://<server-ip-or-domain>:3000

# Base64 HS512 signing key shared by identity-service and all resource services
JWT_SIGNER_KEY=<generate: openssl rand -base64 64>

# Datastore credentials (must match the credentials the data volumes were initialised with)
MONGO_ROOT_PASSWORD=<change-me>
MYSQL_ROOT_PASSWORD=<change-me>
NEO4J_PASSWORD=<change-me-min-8-chars>

# Google OAuth2 (redirect URI must be registered in Google Cloud console:
# ${PUBLIC_BASE_URL}/api/v1/identity/login/oauth2/code/google — Google requires a domain + HTTPS)
GOOGLE_CLIENT_ID=<google-client-id>
GOOGLE_CLIENT_SECRET=<google-client-secret>

# Brevo transactional email (notification-service). Placeholder = service starts, no emails sent.
BREVO_API_KEY=<brevo-api-key>

# Optional
GOOGLE_BOOKS_API_KEY=

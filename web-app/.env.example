# Copy to .env.production.local (or export in the shell / Docker build args)
# before running `npm run build`. Values are baked into the bundle at build time.

# API Gateway base URL. Can be absolute or relative (e.g. /api/v1 when Nginx
# proxies the gateway on the same origin).
REACT_APP_API_GATEWAY=http://localhost:8888/api/v1

# Socket.IO server URL (notification-service).
REACT_APP_SOCKET_URL=http://localhost:8099
